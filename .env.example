# ---------------------------------------------------------------------------
# Front (Vite) — fichier .env / .env.local, variables exposées au navigateur
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLIC_KEY=
VITE_SENDCLOUD_PUBLIC_KEY=
VITE_GOOGLE_MAPS_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_STOREFRONT_URL=

# ---------------------------------------------------------------------------
# Secrets des Edge Functions Supabase — JAMAIS dans le front.
# À définir avec : npx supabase secrets set NOM=valeur --project-ref <project-ref>
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont fournis
# automatiquement par Supabase.)
# ---------------------------------------------------------------------------

# Emails (Resend) — déjà en place
# RESEND_API_KEY=
# INSTANT_BUY_ALERT_EMAIL=

# SAV OZË (chatbot + tickets, migrations 0263-0265)
# Clé API Claude (console.anthropic.com) — utilisée par sav-chat et sav-suggest-reply
# ANTHROPIC_API_KEY=
# Modèle Claude du chatbot (facultatif, défaut claude-sonnet-5-5)
# SAV_CHAT_MODEL=claude-sonnet-5-5
# Destinataire des alertes « nouveau ticket » (défaut sav@ozeparis.com)
# SAV_TEAM_EMAIL=sav@ozeparis.com
# Lien des emails client vers leur demande (défaut https://pro.ozeparis.com)
# PRO_SITE_URL=https://pro.ozeparis.com

# Stripe / Qonto / Sendcloud — déjà en place
# STRIPE_SECRET_KEY=
# QONTO_LOGIN=
# QONTO_SECRET_KEY=
